# ─────────────────────────────────────────────────────────────────────────────
# linqsafe — PROD settings  (linqsafe.com and admin.linqsafe.com)
# Copy this into a file named .env in BOTH app folders on cPanel:
#   /home/linqqkto/linqsafe/.env   and   /home/linqqkto/linqsafe-admin/.env
# Replace every value in <angle brackets>. Never commit the real file.
# After saving: Setup Node.js App → Restart (each app). Check: Run JS script → check
# ─────────────────────────────────────────────────────────────────────────────

NODE_ENV=production

# --- Database (cPanel → MySQL Databases). DB_HOST must be localhost on cPanel. ---
DB_HOST=localhost
DB_PORT=3306
DB_USER=linqqkto_linqsafelive
DB_PASSWORD=<prod database password>
DB_NAME=linqqkto_linqsafe

# --- Login sessions. Long random text, different from dev: openssl rand -hex 32 ---
JWT_SECRET=<64 random characters>

# --- Addresses ---
APP_URL=https://linqsafe.com
OWNER_EMAIL=moyosorejames@gmail.com
# Founder dashboard only opens on this host
ADMIN_HOST=admin.linqsafe.com

# --- Paystack LIVE keys (Paystack → Settings → API Keys & Webhooks). Keep both live. ---
PAYSTACK_SECRET_KEY=sk_live_<...>
PAYSTACK_PUBLIC_KEY=pk_live_<...>

# --- Email (Resend). Leave the key empty to log emails instead of sending. ---
RESEND_API_KEY=re_<...>
MAIL_FROM=linqsafe <support@linqsafe.com>
SUPPORT_EMAIL=support@linqsafe.com

# --- Optional default feature prices in naira per month (the founder dashboard overrides these) ---
# PRICE_UNLIMITED_LINKS=2000
# PRICE_TPL_COVER=1500
# PRICE_TPL_EDITORIAL=1500
# PRICE_TPL_SEARCH=1500
# PRICE_TPL_IDCARD=1500
# PRICE_FOUNDER_NOTE=1000
# PRICE_TESTIMONIALS=1000
# PRICE_QR_CODE=500
# PRICE_ANALYTICS_90=1000
# DISCOUNT_3M=5
# DISCOUNT_6M=10
# DISCOUNT_12M=20
