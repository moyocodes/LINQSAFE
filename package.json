{
  "name": "linqsafe",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "concurrently -n api,web \"node --watch server/index.js\" \"vite\"",
    "build": "vite build",
    "start": "NODE_ENV=production node server/index.js",
    "server": "node server/index.js",
    "preview": "vite preview",
    "set-plan": "node server/scripts/set-plan.js",
    "owner": "node server/scripts/owner.js",
    "test": "node --test tests/*.test.js",
    "package": "sh scripts/package.sh prod",
    "package:dev": "sh scripts/package.sh dev",
    "check": "node server/scripts/check.js",
    "package:admin": "sh scripts/package.sh admin",
    "deps": "npm install --omit=dev --no-audit --no-fund"
  },
  "dependencies": {
    "@paystack/inline-js": "^2.26.0",
    "@radix-ui/react-label": "^2.1.16",
    "@radix-ui/react-slot": "^1.4.0",
    "bcryptjs": "^2.4.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "compression": "^1.8.2",
    "cors": "^2.8.5",
    "countries-and-timezones": "^3.10.0",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "express-async-errors": "^3.1.1",
    "express-rate-limit": "^8.7.1",
    "framer-motion": "^14.0.0",
    "gsap": "^3.15.0",
    "helmet": "^8.3.0",
    "jsonwebtoken": "^9.0.2",
    "lucide-react": "^1.52.0",
    "mysql2": "^3.11.0",
    "qrcode": "^1.5.4",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.26.0",
    "simple-icons": "^16.34.0",
    "tailwind-merge": "^3.7.0",
    "three": "^0.186.1"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.3.1",
    "autoprefixer": "^10.6.1",
    "concurrently": "^8.2.2",
    "postcss": "^8.5.29",
    "tailwindcss": "^3.4.19",
    "tailwindcss-animate": "^1.0.7",
    "vite": "^5.4.0"
  },
  "engines": {
    "node": ">=20"
  },
  "description": "Link-in-bio pages with a 3D animated landing page. React + Vite + Tailwind + Express + MySQL."
}
