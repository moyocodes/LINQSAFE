# ─────────────────────────────────────────────────────────────────────────────
# linqsafe — DEV settings  (dev.linqsafe.com)
# Copy this into a file named .env in the dev app folder on cPanel:
#   /home/linqqkto/linqsafe-dev/.env
# Uses its OWN database and TEST Paystack keys, so testing never touches real users or money.
# Replace every value in <angle brackets>. Never commit the real file.
# After saving: Setup Node.js App → dev.linqsafe.com → Restart. Check: Run JS script → check
# ─────────────────────────────────────────────────────────────────────────────

NODE_ENV=production

# --- Dev database (cPanel → MySQL Databases: a separate database + user from prod) ---
DB_HOST=localhost
DB_PORT=3306
DB_USER=linqqkto_<dev user>
DB_PASSWORD=<dev database password>
DB_NAME=linqqkto_linqsafe_dev

# --- Login sessions. Different from prod: openssl rand -hex 32 ---
JWT_SECRET=<64 random characters, not the prod one>

# --- Addresses ---
APP_URL=https://dev.linqsafe.com
OWNER_EMAIL=moyosorejames@gmail.com
# Only if you set up admin-dev.linqsafe.com; otherwise the founder dashboard is at dev.linqsafe.com/owner
# ADMIN_HOST=admin-dev.linqsafe.com

# --- Paystack TEST keys (Paystack dashboard in Test mode). Test card: 4084 0840 8408 4081 ---
PAYSTACK_SECRET_KEY=sk_test_<...>
PAYSTACK_PUBLIC_KEY=pk_test_<...>

# --- Email (Resend). Same key as prod is fine; leave empty to log emails instead. ---
RESEND_API_KEY=re_<...>
MAIL_FROM=linqsafe <support@linqsafe.com>
SUPPORT_EMAIL=support@linqsafe.com

# --- Optional test prices (naira per month); easier to set in the dev founder dashboard ---
# PRICE_QR_CODE=500
