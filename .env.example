# linqsafe settings template. Ready-made versions per stage: .env.prod.example and .env.dev.example.
# Copy one of them to:
#   .env.local   on your computer (local stage; DB_NAME=linqsafe_local, VITE_APP_STAGE=local, test Paystack keys)
#   .env         on each cPanel app (dev or prod; DB_HOST=localhost, NODE_ENV=production)
# Never commit real values. See docs/DEPLOY.md for the values each stage needs.

# --- Database (MySQL 8+) ---
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=linqsafe_local
# Set to true for hosted MySQL that requires TLS (PlanetScale, Aiven, RDS, ...)
DB_SSL=false

# --- Server ---
PORT=3001
# REQUIRED in production. Generate one with:  openssl rand -hex 32
JWT_SECRET=change-me
# Only needed if the frontend is hosted on a different origin than the API (comma-separated)
# CORS_ORIGIN=https://linqsafe.com

# --- Stage: local | dev | prod (shows a LOCAL/DEV badge outside prod) ---
APP_STAGE=local

# --- Public URL used in emailed links (verify / reset). Defaults to the request's host. ---
# APP_URL=https://linqsafe.com

# --- Email (Resend). Without a key, emails are printed to the server log instead of sent. ---
# RESEND_API_KEY=re_...
# MAIL_FROM=linqsafe <support@linqsafe.com>
# Where replies and contact-form messages go (defaults to support@linqsafe.com / OWNER_EMAIL)
# SUPPORT_EMAIL=support@linqsafe.com

# --- Founder dashboard ---
# Only this email (once verified) can open the founder dashboard.
OWNER_EMAIL=moyosorejames@gmail.com
# Lock the founder API to the admin subdomain (comma-separated). Leave empty locally.
# ADMIN_HOST=admin.linqsafe.com
# Which hostnames the frontend treats as the founder console. Default: any host starting with "admin." or "admin-".
# ADMIN_HOST=admin.linqsafe.com

# --- Paystack (Pro payments, NGN). Use sk_test_... keys in dev, sk_live_... in prod. ---
# Set the webhook URL in Paystack → Settings → API Keys & Webhooks to https://linqsafe.com/api/billing/webhook
# PAYSTACK_SECRET_KEY=sk_test_...
# Public key (pk_test_ / pk_live_). Safe to expose; the server passes it to the browser via /api/billing/config.
# Not needed by the current redirect checkout, only for Paystack's in-page popup.
# PAYSTACK_PUBLIC_KEY=pk_test_...

# --- Feature prices (naira, per MONTH). Customers buy 1, 3, 6 or 12 months of a feature.
# Leave a price empty to keep that feature off sale. You can also change all of these from the
# founder dashboard (/owner → Pricing); values saved there override the ones here.
# PRICE_UNLIMITED_LINKS=2000
# PRICE_TPL_COVER=1500
# PRICE_TPL_EDITORIAL=1500
# PRICE_TPL_SEARCH=1500
# PRICE_TPL_IDCARD=1500
# PRICE_FOUNDER_NOTE=1000
# PRICE_TESTIMONIALS=1000
# PRICE_QR_CODE=500
# PRICE_ANALYTICS_90=1000
# Optional % discount for longer periods (e.g. 10 = 10% off). Leave empty for none.
# DISCOUNT_3M=5
# DISCOUNT_6M=10
# DISCOUNT_12M=20
